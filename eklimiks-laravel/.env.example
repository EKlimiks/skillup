APP_NAME="EKlimiks"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

# Адрес React-приложения (Vite dev-сервер), нужен для CORS и Sanctum
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- OSPanel / локальная разработка ---
# В OSPanel пользователь MySQL обычно "root" без пароля, порт 3306
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eklimiks
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=eklimiks

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000
SANCTUM_TOKEN_EXPIRATION=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@eklimiks.ru"
MAIL_FROM_NAME="${APP_NAME}"

# --- Магазин (используется сидерами и публичными настройками) ---
SHOP_PHONE="+7 (3522) 45-67-87"
SHOP_ADDRESS="Курган, ул. Тверская, 18, ТЦ «Галерея», 2 этаж"
SHOP_TELEGRAM="@eklimiks_store"
SHOP_BONUS_PERCENT=2
